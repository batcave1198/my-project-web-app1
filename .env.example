# ---------------------------------------------------------------------------
# Copy to .env (local) or set these in the Hostinger VPS process manager.
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL 17 (production: postgresql://user:pass@localhost:5432/ceylon?schema=public)
DATABASE_URL="postgresql://postgres@localhost:5433/ceylon_dev?schema=public"

# 48 random bytes, base64url encoded: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Initial administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@ceylonherbs.local"
SEED_ADMIN_PASSWORD=""

# PayHere (https://www.payhere.lk) — sandbox or live
PAYHERE_MODE="sandbox"
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_NOTIFY_URL="http://localhost:3000/api/payments/payhere/notify"

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="ceylon-herbs-spices"

# Transactional email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Ceylon Herbs and Spices <no-reply@localhost>"
