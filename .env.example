# ---------------------------------------------------------------------------
# Copy to .env (local) or set these in the Hostinger VPS process manager.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Do not set NODE_ENV in this file. `next dev` sets development and
# `next start` sets production. Setting it here overrides Next.js and breaks
# secure cookies, CSP and production-only behaviour.

# Public URL of the site. Emails and PayHere callbacks are built from this.
APP_URL="http://localhost:3000"

# PostgreSQL 17
# Local portable cluster (npm run db:setup):
DATABASE_URL="postgresql://postgres@localhost:5433/ceylon_dev?schema=public"
# Production example:
# DATABASE_URL="postgresql://ceylon:STRONG_PASSWORD@127.0.0.1:5432/ceylon?schema=public"

# 48 random bytes, base64url encoded:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Set true ONLY when Nginx (or another trusted reverse proxy) is in front of
# the app and overwrites X-Real-IP / X-Forwarded-For. Leaving this false makes
# the app ignore those headers and use the direct connection address.
TRUST_PROXY="false"

# Initial administrator created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@ceylonherbs.local"
SEED_ADMIN_PASSWORD=""

# PayHere (https://www.payhere.lk) — sandbox or live
PAYHERE_MODE="sandbox"
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_NOTIFY_URL="http://localhost:3000/api/payments/payhere/notify"

# Transactional email (verification, password reset, paid order receipts).
# Leave SMTP_HOST blank to disable sending. Port 465 uses SSL/TLS; port 587
# uses STARTTLS. MAIL_FROM must normally be a mailbox/domain approved by the
# SMTP provider (for example Hostinger Email).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Ceylon Herbs and Spices <no-reply@yourdomain.com>"

# The cleanup command (`npm run uploads:cleanup`) deletes unreferenced images
# older than this many hours. Run it daily on the VPS.
UPLOAD_RETENTION_HOURS="24"

# Cloudinary is reserved for future use. Product, blog, gallery and review
# images are stored locally in public/uploads and are NOT sent to Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="ceylon-herbs-spices"
